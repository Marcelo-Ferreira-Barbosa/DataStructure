# Copie para .env (que NÃO é versionado): cp .env.example .env
# Valores apenas para desenvolvimento local. Nunca coloque segredos reais aqui.

# NODE_ENV não é definido aqui de propósito: no .env ele faria o Vite gerar
# o build de produção com o React em modo de desenvolvimento (bundle ~2x maior).
# A API assume 'development' quando ausente; em produção é definido pelo ambiente.

# Porta da API (Express)
PORT=3000

# Origem do front-end em desenvolvimento (servidor do Vite).
# Usada pela API para a verificação de Origin nas mutações (API.md §2.3).
APP_ORIGIN=http://localhost:5173
