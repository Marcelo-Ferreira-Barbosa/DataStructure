{
  "name": "datastructure-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dss/api --filter @dss/web dev",
    "dev:web": "pnpm --filter @dss/web dev",
    "dev:api": "pnpm --filter @dss/api dev",
    "build": "pnpm --filter @dss/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "pnpm -r test",
    "test:coverage": "pnpm --filter @dss/engine test:coverage",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.2"
  }
}
